{
  "name": "@pomodoro/desktop",
  "version": "0.1.0-beta.1",
  "description": "A local-first desktop focus timer.",
  "author": "Easton",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run rebuild:native && electron-vite dev",
    "build": "electron-vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run rebuild:native && playwright test",
    "package": "npm run build && electron-builder",
    "rebuild:native": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.easton.pomodotimer",
    "productName": "Pomodoro Timer",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "icons",
        "filter": [
          "pomodoro-timer.icns",
          "pomodoro-timer.ico",
          "pomodoro-timer.png"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "artifactName": "Pomodot-${version}-mac-${arch}.${ext}",
      "icon": "resources/icons/pomodoro-timer.icns",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "artifactName": "Pomodot-${version}-windows-${arch}-setup.${ext}",
      "icon": "resources/icons/pomodoro-timer.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
